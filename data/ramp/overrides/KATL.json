{
  "_comment": [
    "Hand-authored overlay for KATL, merged over the OSM/apt.dat build output.",
    "Stand inventory, positions, headings and sizes come from the build — NOT from this file.",
    "This file carries only what no machine-readable source publishes: which airlines use",
    "which concourse, how concourses group into ramp control areas, and local corrections.",
    "UNVERIFIED — first cut compiled from public airport/terminal guides (Aug 2026).",
    "Ramp grouping and frequencies are placeholders pending confirmation."
  ],
  "icao": "KATL",

  "ramps": [
    { "id": "R1", "label": "Ramp 1", "concourses": ["T"],     "freq": null, "_status": "placeholder" },
    { "id": "R2", "label": "Ramp 2", "concourses": ["A", "B"], "freq": null, "_status": "placeholder" },
    { "id": "R3", "label": "Ramp 3", "concourses": ["C", "D"], "freq": null, "_status": "placeholder" },
    { "id": "R4", "label": "Ramp 4", "concourses": ["E", "F"], "freq": null, "_status": "placeholder" }
  ],

  "concourses": {
    "T": { "label": "Concourse T", "domestic": true },
    "A": { "label": "Concourse A", "domestic": true },
    "B": { "label": "Concourse B", "domestic": true },
    "C": { "label": "Concourse C", "domestic": true },
    "D": { "label": "Concourse D", "domestic": true },
    "E": { "label": "Concourse E", "domestic": true, "intl": true },
    "F": { "label": "Concourse F — Maynard H. Jackson Jr. Intl Terminal", "intl": true }
  },

  "operatorBlocks": {
    "DAL": { "concourses": ["T", "A", "B", "C", "D"], "intl": ["E", "F"], "_note": "hub carrier — uses the whole field" },
    "EDV": { "inherits": "DAL", "prefer": ["C", "D"], "_note": "Endeavor — Delta Connection regional" },
    "SKW": { "inherits": "DAL", "prefer": ["C", "D"] },
    "RPA": { "inherits": "DAL", "prefer": ["C", "D"] },
    "JIA": { "inherits": "DAL", "prefer": ["C", "D"] },

    "AAL": { "concourses": ["T"] },
    "UAL": { "concourses": ["T"] },
    "ASA": { "concourses": ["C"] },
    "SWA": { "concourses": ["C"], "gateRanges": ["C1-C22"], "_note": "south end of C" },
    "NKS": { "concourses": ["C", "D"] },
    "FFT": { "concourses": ["C", "D", "E"] },
    "JBU": { "concourses": ["T"] },

    "AMX": { "concourses": ["E"] },
    "ACA": { "concourses": ["E", "F"] },
    "WJA": { "concourses": ["F"] },
    "AFR": { "concourses": ["F"] },
    "KLM": { "concourses": ["F"] },
    "BAW": { "concourses": ["F"] },
    "VIR": { "concourses": ["F"] },
    "DLH": { "concourses": ["F"] },
    "KAL": { "concourses": ["F"] },
    "THY": { "concourses": ["F"] },
    "QTR": { "concourses": ["F"] },
    "ETH": { "concourses": ["F"] },
    "ETD": { "concourses": ["F"] },

    "FDX": { "opsType": "cargo" },
    "UPS": { "opsType": "cargo" },
    "GTI": { "opsType": "cargo" },

    "*":      { "concourses": ["T"], "_note": "unlisted domestic carrier" },
    "*_INTL": { "concourses": ["F"], "_note": "unlisted international carrier" },
    "*_GA":   { "opsType": "ga" }
  },

  "_sources": [
    "atl.com concourse maps and airport terminal guides",
    "upgradedpoints.com / airlineairport.com ATL terminal guides (Aug 2026)",
    "Southwest C1-C22 (south end of C); AAL + UAL on T; non-Delta international on F"
  ],
  "_confirm": [
    "Ramp control area grouping and frequencies — placeholders above.",
    "Frontier appears on C, D and E across sources; pick the one that matches VATSIM practice.",
    "Concourse E gate range: airport guides say E1-E6, but the reference screenshots show E2-E36. Trust the built geometry."
  ]
}
