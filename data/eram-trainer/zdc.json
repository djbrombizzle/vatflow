    },
    {
      "id": "qs-heading-360",
      "type": "hdg",
      "instruction": "Fly heading 360 for FDX1804.",
      "aircraft": "FDX1804",
      "expect": { "verb": "QS", "hdg": 360, "mode": "NP" },
      "hint": "North is heading 360."
    },
    {
      "id": "qz-climb-low",
      "type": "alt",
      "instruction": "Climb ENY3844 and maintain 12,000 feet.",
      "aircraft": "ENY3844",
      "expect": { "verb": "QZ", "alt": 120 },
      "hint": "Below FL180 use 3-digit hundreds: 120 = 12,000 ft."
    },
    {
      "id": "qu-direct-rbv",
      "type": "direct",
      "instruction": "Proceed direct RBV for UPS1122.",
      "aircraft": "UPS1122",
      "expect": { "verb": "QU", "fix": "RBV" },
      "hint": "QU sends PROCEED DIRECT TO <fix>."
    },
    {
      "id": "qs-speed-250",
      "type": "spd",
      "instruction": "Reduce to 250 knots for AAY2291.",
      "aircraft": "AAY2291",
      "expect": { "verb": "QS", "kt": 250 },
      "hint": "Speed range 80–400 knots."
    }
