<?xml version="1.0" encoding="utf-8"?>
<!--
	VATFLOW Tower Cab: no aircraft sounds (engine, wind, rattles, airframe creaks): the cab is
	a SimObject "aircraft" only so it can be placed and frozen on the tower. No Wwise packages.
	The one sound is the windshear alarm: a plain .wav (vatflow_windshear.wav, next to this
	file, made by tools/make_alert_sound.py) in one of the sim's custom cockpit warning slots
	(WaveData, WwiseData="False"), looping while the TWR INFO screen's windshear alert sounds
	(L:VATFLOW_WS_ALERT = 1; MUTE or the end of the alert sets it to 0).
	The cab fan is played by the placement tool instead (placement/cab_fan.wav).
-->
<SoundInfo Version="0.1">
	<WwisePackages>
	</WwisePackages>
	<SimVarSounds>
		<Sound WwiseData="False" WwiseEvent="custom_warning_cockpit_sound_01" FileName="vatflow_windshear"
			LocalVar="VATFLOW_WS_ALERT" Continuous="True" ViewPoint="Inside">
			<Range LowerBound="0.5" UpperBound="2"/>
		</Sound>
	</SimVarSounds>
</SoundInfo>
